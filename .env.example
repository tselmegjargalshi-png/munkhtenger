# Munkhtenger environment variables. Copy to .env.local and fill in.
# With no values set, the app runs in DEMO MODE (data stored in the browser).

# Supabase (optional, enables the Supabase data provider once wired; see README)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for share links and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map provider (optional). Without a token the schematic demo map is used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Payment gateways (optional, not integrated in demo mode)
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
SOCIALPAY_TERMINAL=
SOCIALPAY_SECRET=
